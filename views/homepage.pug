doctype html
html
  head
    title= title
    link(rel="stylesheet", href="/css/style.css")
  body
    h1 Custom Object Table
    a(href="/update-cobj") Add to this table
    table
      thead
        tr
          th Name
          th Publisher
          th Price
      tbody
        each record in data
          tr
            td= record.properties.name
            td= record.properties.publisher
            td= record.properties.price